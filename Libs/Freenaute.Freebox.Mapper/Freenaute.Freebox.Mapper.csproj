<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <!-- Single-package strategy: only Freenaute.Freebox.Client is published; this assembly is embedded in it. -->
        <IsPackable>false</IsPackable>
        <!-- Preserve wire-contract/public signatures until the dedicated API cleanup and compatibility review. -->
        <NoWarn>$(NoWarn);MA0015;MA0016</NoWarn>
        <!-- The reported generated-style contract/converter code is reviewed by the mapper/conversion workstream. -->
        <NoWarn>$(NoWarn);MA0051;MA0074</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Remove="ZeroAlloc.Analyzers"/>
    </ItemGroup>
</Project>
