<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <!-- Tests intentionally control cancellation, synchronization context and string comparison fixtures. -->
        <!-- xUnit1031 is used only by compatibility tests that exercise synchronous public entry points. -->
        <NoWarn>$(NoWarn);MA0002;MA0004;MA0006;MA0051;MA0074;xUnit1031;xUnit1051</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Remove="ZeroAlloc.Analyzers"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../Libs/Freenaute.Freebox.Client/Freenaute.Freebox.Client.csproj"/>
    </ItemGroup>
</Project>
