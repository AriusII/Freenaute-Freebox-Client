<Project>
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>15</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <ArtifactsPath>$(MSBuildThisFileDirectory).artifacts/build</ArtifactsPath>
        <PackageOutputPath>$(MSBuildThisFileDirectory).artifacts/nuget</PackageOutputPath>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <Deterministic>true</Deterministic>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest</AnalysisLevel>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <EnablePackageValidation>true</EnablePackageValidation>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <RepositoryUrl>https://github.com/AriusII/Freenaute-Freebox-Api</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <VersionPrefix>1.1.0</VersionPrefix>
        <Authors>AriusII</Authors>
        <Company>Freenaute</Company>
        <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Freenaute</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/AriusII/Freenaute-Freebox-Api</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all"/>
        <PackageReference Include="ZeroAlloc.Analyzers" PrivateAssets="all"/>
    </ItemGroup>
</Project>
